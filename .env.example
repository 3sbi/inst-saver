# Source account, without @ (a leading @ is also accepted).
INSTAGRAM_HANDLE=source_account
# Public accounts only. No Instagram login or third-party API key is required.
# Public channel handle, including @; private channels can use a -100... ID.
TELEGRAM_CHANNEL=@your_channel
TELEGRAM_BOT_TOKEN=123456789:replace_me
# Obtain application credentials at https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
POLL_INTERVAL_SECONDS=300
